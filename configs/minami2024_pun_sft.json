{
  "name": "minami2024-pun-lora",
  "source": "JSAI 2024 2G5-GS-6-03",
  "model_name": "outputs/minami2024-reading",
  "task": "pun_sft",
  "data_files": {
    "train": "data/pun_sft/train.jsonl",
    "validation": "data/pun_sft/validation.jsonl"
  },
  "output_dir": "outputs/minami2024-pun",
  "seed": 42,
  "lora": {
    "r": 16,
    "alpha": 64,
    "dropout": 0.0,
    "target_modules": ["q_proj", "k_proj"]
  },
  "training": {
    "learning_rate": 0.0001,
    "num_train_epochs": 5,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 32,
    "warmup_ratio": 0.2,
    "lr_scheduler_type": "cosine",
    "bf16": true,
    "gradient_checkpointing": true,
    "max_length": 1024,
    "report_to": "none"
  },
  "notes": "Paper reports batch size 32, 5 epochs, max LR 1e-4, 20% warmup + cosine for pun fine-tuning. Input data must be a legally obtained pun/paraphrase dataset."
}
